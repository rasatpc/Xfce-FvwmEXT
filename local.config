## /.fvwm/local.config
# This runs on Fvwm3 and Fvwm2

## Don't add or edit this file but .fvwm/userExt.sys

SetEnv EXT_DIR $[HOME]/.fvwm/Extension
SetEnv SUP_DIR $[HOME]/.fvwm/Setup
SetEnv USER_DIR $[HOME]/.fvwm/User

AddToFunc StartFunction
+ I Module FvwmEvent EventNewDesk
+ I KillModule FvwmButtons *RightPanel
+ I Module FvwmMFL

## Copy essential folders and files to assigned locations
## and deskIcon postion.

Exec exec sh $[SUP_DIR]/copySampleToUser.sh
Exec exec sh $[SUP_DIR]/ButtonScreenPosition.sh
Exec exec sh $[SUP_DIR]/copyFvwmAutostart.sh
Exec exec sh $[SUP_DIR]/conky-tmp.sh

## Removes hidden files generated by Fvwm replace.
Exec exec sh $[SUP_DIR]/RemoveFS.sh

## Remove move and resize grid.
OpaqueMoveSize unlimited
Style * ResizeOpaque, SnapAttraction 15 SameType ScreenAll, SnapGrid

## Remember focused window in current page.

SetEnv FocusPage 0

DestroyFunc SavePageFocus
AddToFunc SavePageFocus
+ I All (CurrentPage) State $[FocusPage] False
+ I Current State $[FocusPage] True

## Restore previous focused window in current page.

DestroyFunc RestorePageFocus
AddToFunc RestorePageFocus
+ I Current (CurrentPage) Break 1
+ I Next (CurrentPage, State $[FocusPage]) Focus
+ I None (CurrentPage, Focused) Prev (CurrentPage) Focus

DestroyModuleConfig FvwmEvent-FDpg:*
*FvwmEvent-FDpg: Cmd
*FvwmEvent-FDpg: new_page RestorePageFocus
*FvwmEvent-FDpg: new_desk RestorePageFocus
*FvwmEvent-FDpg: focus_change SavePageFocus

Module FvwmEvent FvwmEvent-FDpg

## Vertical/horizontal tiling and testing which text editor is available.
## The variable EDT loads the available editor for the ControlMiniPanel.

Read $[EXT_DIR]/Functions/tile-edit.sys

#######################
## EXTENSION
#######################

## Don't change or add new features, will be overwritten in
## next update.
## Make the changes in userExt.sys file.

## FUNCTIONS (launcher, thumbnail, window position, etc)

Read $[EXT_DIR]/Functions/deskPgNo.sys
Read $[EXT_DIR]/Functions/deskIcons.sys
Read $[EXT_DIR]/Functions/Thumbnails/thumbnail.sys

## COLORSETS (color settings, etc.)

Read $[EXT_DIR]/Colorsets.sys

## MENUS  (menu style, list, etc.)

Read $[EXT_DIR]/Menu.conf

## BINDINGS  (window list, move/resize, etc.)

Read $[EXT_DIR]/Binding.sys

## DECOR  (window title bar, border, etc.)

Read $[EXT_DIR]/Decor/4BtmDecor/button4Dec.sys

## MODULES (control-panel, desk-icon, pager, etc.)

Read $[EXT_DIR]/Modules/ControlMinPanel/controlMP.sys
Read $[EXT_DIR]/Modules/FvwmOverView/Oview.sys
Read $[EXT_DIR]/Modules/vPager.sys

###########################################
## Change preloaded settings.
###########################################

##### EdgeScroll
## This will move the view port between the pages when the mouse
## moves to the edge of the screen.

EdgeScroll 0 0
EdgeResistance -1
EdgeThickness 1
Style * EdgeMoveDelay 500, EdgeMoveResistance 100

##### EwmhBaseStruts
## EwmhBaseStruts [left] [right] [top] [bottom]
## Reserves space along the edge(s) of the Screen that will not
## be covered when maximizing or placing windows.

EwmhBaseStruts 110 170 70 70

##### Mouse
## Mouse click behaviour and window focus.

Style * ClickToFocus, FPGrabFocus

##### Window Placement
## Style to center the window location.

Style * TileCascadePlacement

##### Exit panel 
## Center panel postion.

Style ConfirmQuit !Title, PositionPlacement Center, WindowListSkip, Layer 6

###########################################
## OTHER changes and addon.
###########################################

##### Hide GeometryWindow (window position text, left top corner).

GeometryWindow Hide

##### Change Window title bar font.

DefaultFont "xft:Noto:Sans:size=11"

##### Hide Xfce Whisker Menu title bar and border.

Style *Whisker* NoTitle, NoHandles, BorderWidth 0, NeverFocus
Style *Conky* NoTitle, NoHandles, BorderWidth 0, NeverFocus
Style *plasma* NoTitle, NoHandles, BorderWidth 0, NeverFocus

#######################
## USER
#######################

## To make changes and add new features without being overwritten
## by new updates, this reads the userExt.sys file.

Read $[HOME]/.fvwm/userExt.sys
