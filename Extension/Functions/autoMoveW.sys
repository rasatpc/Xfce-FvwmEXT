## Functions: autoMoveW.sys
#
## Automatically move applications to a specific desk/page
## when they create windows.

## Copy this config to ~/.fvwm/User and edit for your installed apps.

##		APPS		COMMAND			DESK/PAGE/SCREEN LOCATION
## --------------------------------------------------------------------

Style	*Firefox 	StartsOnPage	0 0 0	# desk 0
Style	Chromium	StartsOnPage	0 0 0   # desk 0
#Style	Evolution	StartsOnPage	1 0 0   # desk 1
# Style	"Mozilla Thunderbird"	StartsOnPage	1 0 0	# desk 1
#Style	Gimp		StartsOnPage	2 0 0	# desk 2
