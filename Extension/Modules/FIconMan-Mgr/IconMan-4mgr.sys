# Modules: IconMan-4mgr.sys
# FvwmIconMan with Four Managers and FvwmButtons MenuPanel

# USER APPLICATION SELECTION PROFILE
Read $[EXT_DIR]/Modules/FIconMan-Mgr/manager-menu.conf

# Remove existing modules on reload
KillModule FvwmButtons FvwmPanel
KillModule FvwmButtons MgrMenuBar
KillModule FvwmIconMan

## Time/Day panel
Style FvwmScript !Borders, !Title

# Manager Background
Colorset 9 fg #ffffff, bg #066e92, hi #066e92, sh #066e92, Plain, NoShape
# ColorSet 9 RootTransparent Buffer, Tint #29353b 15, fg black, bg white

# Minimized Windows
Colorset 39 fg #000000, bg #59667c, hi #4b5563, sh #1f2937, Plain, NoShape

DestroyFunc FocusAndRaise
AddToFunc FocusAndRaise
+ I Iconify false
+ I Raise
+ I Focus

# MenuPanel
# Check manager-menu.conf

# MENU BUTTON (FvwmButtons: 90x25 button + 1px white line)
# ========================================================
DestroyModuleConfig MgrMenuBar: *
*MgrMenuBar: Geometry 90x26-0+352
*MgrMenuBar: Rows 26
*MgrMenuBar: Columns 1
*MgrMenuBar: Frame 0
*MgrMenuBar: Padding 0 0
*MgrMenuBar: Colorset 36
*MgrMenuBar: Font "xft:Sans:size=10:antialias=true"

*MgrMenuBar: (1x25, Title "Menu", ActionOnPress, Action(Mouse 1) "Menu MenuPanel rectangle $widthx$height+$left+$top -105m 0")
*MgrMenuBar: (1x1, Colorset 12, Frame 0)

Style MgrMenuBar !Title, !Borders, Sticky, WindowListSkip, StaysOnBottom, EWMHIgnoreStrutHints, NeverFocus

# GLOBAL BUTTON PROPERTIES & COLORS
# ====================================

DestroyModuleConfig FvwmIconMan:*
*FvwmIconMan: NumManagers 4

*FvwmIconMan: * ButtonGeometry 90x24
*FvwmIconMan: * Format "%c"
*FvwmIconMan: * Font "xft:Sans:size=9:antialias=true"
*FvwmIconMan: * Resolution global
*FvwmIconMan: * DrawIcons always
*FvwmIconMan: * Sort id

# Apply Colorsets & Flat Button Relief
*FvwmIconMan: * Colorset 		9		# Background
*FvwmIconMan: * PlainColorset	36	 	# Window unfocus
*FvwmIconMan: * FocusColorset	35	 	# Window focus
*FvwmIconMan: * IconColorset	39		# Window minimized

*FvwmIconMan: * ReliefThickness 1
*FvwmIconMan: * PlainButton		flat
*FvwmIconMan: * FocusButton		up
*FvwmIconMan: * SelectButton	flat
*FvwmIconMan: * IconButton		flat

## Mouse Actions
# ====================================
# Left-click (1), Middle-click (2), and Right-click (3) inside Manager areas.
*FvwmIconMan: * Action Mouse 1 N sendcommand "Function FocusAndRaise"
*FvwmIconMan: * Action Mouse 2 N sendcommand "Thumbnail"
*FvwmIconMan: * Action Mouse 3 N sendcommand "Close"

# Middle-scroll - Move window one Desk up and down.
*FvwmIconMan: * Action Mouse 4 A sendcommand "MoveToDesk +1"
*FvwmIconMan: * Action Mouse 5 A sendcommand "MoveToDesk -1"

# Ctrl + Right-click - Window Cloning
*FvwmIconMan: * Action Mouse 3 C sendcommand "Exec exec $[w.resource]"

# MANAGER 1-4 (Positioned vertically on right edge)
# =================================================

# 1. Web browsers, email, and chat clients
*FvwmIconMan: 1 Title "Web-Com"
*FvwmIconMan: 1 ManagerGeometry 1x4-0+379
*FvwmIconMan: 1 Show $[infostore.AppGroup_WebCom]

# 2. Graphics, media players, and LibreOffice suite
*FvwmIconMan: 2 Title "Grap-Med"
*FvwmIconMan: 2 ManagerGeometry 1x4-0+500
*FvwmIconMan: 2 Show $[infostore.AppGroup_GraphMed]

# 3. Terminals, IDEs/editors, file managers, and system tools
*FvwmIconMan: 3 Title "Dev-Syst"
*FvwmIconMan: 3 ManagerGeometry 1x4-0+621
*FvwmIconMan: 3 Show $[infostore.AppGroup_DevSys]

# 4. Everything else (catch-all via DontShow)
*FvwmIconMan: 4 Title "Misc-App"
*FvwmIconMan: 4 ManagerGeometry 1x4-0+742
*FvwmIconMan: 4 DontShow  $[infostore.AppGroup_DevSys] \
						  $[infostore.AppGroup_WebCom] \
						  $[infostore.AppGroup_GraphMed]

# STARTUP & STYLES

AddToFunc StartFunction
+ I Module FvwmButtons MgrMenuBar
+ I Module FvwmIconMan

# Disable all 10 titlebar layout buttons individually
Style FvwmIconMan !Button 0, !Button 1, !Button 2, !Button 3, !Button 4
Style FvwmIconMan !Button 5, !Button 6, !Button 7, !Button 8, !Button 9

# Text-only, flat appearance, remove frames, Titlebar Colorset 36.
Style FvwmIconMan Font "xft:Sans:size=11:antialias=true", Title, TitleAtTop, MwmButtons, NoHandles, HandleWidth 0, BorderWidth 0, Sticky, WindowListSkip, EWMHIgnoreStrutHints, NeverFocus, !Iconifiable, Colorset 36
