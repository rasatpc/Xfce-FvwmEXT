# Modules: IconMan-4mgr.sys
# FvwmIconMan with 4 Managers + Menu Panel

# Remove FvwmPanel
KillModule FvwmButtons FvwmPanel
KillModule FvwmIconMan

## Time/Day panel
Style FvwmScript !Borders, !Title

# Manager Background
Colorset 9 fg #ffffff, bg #066e92, hi #066e92, sh #066e92, Plain, NoShape
# ColorSet 9 RootTransparent Buffer, Tint #29353b 15, fg black, bg white

# Minimized Windows
Colorset 39 fg #000000, bg #59667c, hi #4b5563, sh #1f2937, Plain, NoShape

DestroyFunc FocusAndRaise
AddToFunc FocusAndRaise
+ I Iconify false
+ I Raise
+ I Focus

# MenuPanel
DestroyMenu MenuPanel
AddToMenu MenuPanel
+ "Restart " Restart
+ "Identify " NoWindow Module FvwmIdent
Test (x FvwmPrompt) + "Fvwm Prompt " Exec exec xterm "FvwmPrompt"
Test (!x FvwmPrompt) + "Fvwm Console " Module FvwmConsole -terminal
+ "Window List " TriggerWindowLookUp
+ "" Nop
+ "Apps " $[infostore.EDT] $[EXT_DIR]/Modules/RightTaskMgr/manager-menu.conf
+ "Bindings  " $[infostore.EDT] $[EXT_DIR]/Modules/RightTaskMgr/taskBarMouseB.txt
+ "Fvwm Wallpapers" Popup BGMenu item -0 +17m

# GLOBAL BUTTON PROPERTIES & COLORS
# ====================================

DestroyModuleConfig FvwmIconMan:*
*FvwmIconMan: NumManagers 5

*FvwmIconMan: * ButtonGeometry 90x25
*FvwmIconMan: * Format "%c"
*FvwmIconMan: * Font "xft:Sans:size=9:antialias=true"
*FvwmIconMan: * Resolution global
*FvwmIconMan: * DrawIcons always
*FvwmIconMan: * Sort id

# Apply Colorsets & Flat Button Relief
*FvwmIconMan: * Colorset 		9		# Background
*FvwmIconMan: * PlainColorset	36	 	# Window unfocus
*FvwmIconMan: * FocusColorset	35	 	# Window focus
*FvwmIconMan: * IconColorset	39		# Window minimized

*FvwmIconMan: * ReliefThickness 1
*FvwmIconMan: * PlainButton		flat
*FvwmIconMan: * FocusButton		up
*FvwmIconMan: * SelectButton	flat
*FvwmIconMan: * IconButton		flat

*FvwmIconMan: * TitleButton     flat
*FvwmIconMan: * TitleColorset   9		# Match panel hide background

## Mouse Actions
# ====================================
# Left-click (1), Middle-click (2), and Right-click (3) inside Manager areas.
*FvwmIconMan: * Action Mouse 1 N sendcommand "Function FocusAndRaise"
*FvwmIconMan: * Action Mouse 2 N sendcommand "Thumbnail"
*FvwmIconMan: * Action Mouse 3 N sendcommand "Close"

# Middle-scroll - Move window one Desk up and down.
*FvwmIconMan: Action Mouse 4 A sendcommand "MoveToDesk +1"
*FvwmIconMan: Action Mouse 5 A sendcommand "MoveToDesk -1"

# Ctrl + Right-click - Window Cloning
*FvwmIconMan: Action Mouse 3 C sendcommand "Exec exec $[w.resource]"

# Left-click "Menu" titlebar opens MenuPanel; normal windows click and move.
Mouse 1 T A CheckMenuPanel
DestroyFunc CheckMenuPanel
AddToFunc CheckMenuPanel
+ C ThisWindow ("Menu") Menu MenuPanel Rectangle $[w.width]x$[w.height]+$[w.x]+$[w.y] -105m 0
+ C TestRc (NoMatch) Raise
+ M Move

# Ask AI to adjust the application groupings.

# MANAGER 1-5 (Positioned vertically on right edge)
# =================================================
*FvwmIconMan: 5 Title "Menu"
*FvwmIconMan: 5 ManagerGeometry 1x1-0+324
*FvwmIconMan: 5 Show class=None
*FvwmIconMan: 5 Colorset 12

*FvwmIconMan: 1 Title "Web & Com"
*FvwmIconMan: 1 ManagerGeometry 1x4-0+351
*FvwmIconMan: 1 Show class=Firefox class=firefox class=Chromium class=Google-chrome class=Brave-browser

*FvwmIconMan: 2 Title "Grap& Med"
*FvwmIconMan: 2 ManagerGeometry 1x3-0+476
*FvwmIconMan: 2 Show class=XTerm class=Alacritty class=Kitty class=Gnome-terminal

*FvwmIconMan: 3 Title "Dev & Syst"
*FvwmIconMan: 3 ManagerGeometry 1x3-0+576
*FvwmIconMan: 3 Show class=Code class=Sublime_text class=Thunar class=Nautilus

*FvwmIconMan: 4 Title "Misc& App"
*FvwmIconMan: 4 ManagerGeometry 1x5-0+676
*FvwmIconMan: 4 DontShow class=Firefox class=firefox class=Chromium class=Google-chrome class=Brave-browser class=XTerm class=Alacritty class=Kitty class=Gnome-terminal class=Code class=Sublime_text class=Thunar class=Nautilus

Style Menu StaysOnBottom, Colorset 10

# STARTUP & STYLES

AddToFunc StartFunction
+ I Module FvwmIconMan

# Disable all 10 titlebar layout buttons individually
Style FvwmIconMan !Button 0, !Button 1, !Button 2, !Button 3, !Button 4
Style FvwmIconMan !Button 5, !Button 6, !Button 7, !Button 8, !Button 9

# Text-only, flat appearance, remove frames, Titlebar Colorset 36.
Style FvwmIconMan Font "xft:Sans:Bold:size=10:antialias=true", Title, TitleAtTop, MwmButtons, Flat, NoHandles, HandleWidth 0, BorderWidth 0, Sticky, WindowListSkip, EWMHIgnoreStrutHints, Colorset 36
