## Extention: Colorsets.sys

## Colorsets configures the color of the various parts of Fvwm
## such as window decor, menus, modules, etc. This list includes
## horizontal and vertical gradients.
## https://www.fvwm.org/Wiki/Config/Colorsets

# Colorset Convention
#
#   0 - Default
#   1 - Inactive Windows
#   2 - Active Window
#   3 - Inactive Windows Borders
#   4 - Active Windows Borders
#   5 - Menu - Inactive Item
#   6 - Menu - Active Item
#   7 - Menu - Grayed Item
#   8 - Menu - Title
#   9 - Reserved
#  10+ Modules
#      10 - Module Default
#      11 - Module Hilight
#      12 - Module ActiveButton (Mouse Hover)
#      13 - FvwmPager Active Page
#      14 - FvwmIconMan Iconified Button

Colorset 0  fg #ffffff, bg #2b4e5e, hi, sh, Plain, NoShape
Colorset 1  fg #000000, bg #88b2b1, hi, sh, Plain, NoShape
Colorset 2  fg #ffffff, bg #2b4e5e, hi, sh, Plain, NoShape
Colorset 3  fg black, bg #415554, hi, sh, Plain, NoShape
Colorset 4  fg black, bg #14252c, hi #24424f, sh #111f26, Plain, NoShape
Colorset 5  fg #000000, bg #cbdcca, hi, sh, Plain, NoShape
Colorset 6  fg #ffffff, bg #88b2b1, hi, sh, Plain, NoShape
Colorset 7  fg #999999, bg #cbdcca, hi, sh, Plain, NoShape
Colorset 8  fg #ffffff, bg #2b4e5e, hi, sh, Plain, NoShape
Colorset 10 fg #ffffff, bg #2b4e5e, hi #aaaaaa, sh #999999, Plain, NoShape
Colorset 11 fg #ffffff, bg #1a6e99, hi #ffffff, sh #ffffff, Plain, NoShape
Colorset 12 fg #2d2d2d, bg #ffffff, hi, sh, Plain, NoShape
Colorset 13 fg #ffffff, bg #006c6c, hi, sh, Plain, NoShape
Colorset 14 fg #a8988f, bg #2b4e5e, hi #aaaaaa, sh #999999, Plain, NoShape

## Transparent
ColorSet 15 RootTransparent Buffer, Tint #4a516a 50, fg white, bg black

### GREEN
Colorset 16 VGradient 50 #638079 #b6b6b6, fg #ffffff

## FvwmPager
Colorset 17 fg #ffffff, bg #028383, hi, sh, Plain, NoShape
Colorset 18 fg #ffffff, bg #306ea2, hi #ffffff, sh #ffffff, Plain
Colorset 34 fg #ffffff, bg #3a697e, hi, sh, Plain, NoShape
Colorset 33 bg #d9d9d9, NoShape
Colorset 35 fg #ffffff, bg #18658d, hi, sh, Plain, NoShape

## No borderline
Colorset 19 fg #ffffff, bg #2b4e5e, hi #2b4e5e, sh #2b4e5e
Colorset 20 fg #ffffff, bg #4e3715, hi #2b4e5e, sh #2b4e5e

## FvwmPager and Stallone traybar
Colorset 21  fg #ffffff, bg #028383, hi, sh, Plain, NoShape
Colorset 22  fg #ffffff, bg #000000, hi, sh, Plain, NoShape

